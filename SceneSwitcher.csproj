<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SceneSwitcher</AssemblyName>
    <RootNamespace>SceneSwitcher</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Required by the assembly publicizer (accessing non-public game members). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Game install. Only READ from here: assemblies are referenced, never copied back. -->
    <GameDir Condition="'$(GameDir)' == ''">E:\Program Files (x86)\Steam\steamapps\common\REPO</GameDir>
    <ManagedDir>$(GameDir)\REPO_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The unit test project lives under this folder but builds separately. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- Private=false: never copy referenced DLLs into our output. -->
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!-- BepInEx 5 + HarmonyX -->
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)\BepInEx.dll" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" />

    <!-- Game -->
    <!-- Publicize: compile against a copy (in obj/) with internal members made public. -->
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Publicize="true" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" />
    <Reference Include="PhotonUnityNetworking" HintPath="$(ManagedDir)\PhotonUnityNetworking.dll" />
    <Reference Include="PhotonRealtime" HintPath="$(ManagedDir)\PhotonRealtime.dll" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" />
  </ItemGroup>

  <!-- After each build, stage only the plugin DLL in dist/SceneSwitcher/,
       ready to be copied as-is into BepInEx/plugins/. -->
  <Target Name="StageDist" AfterTargets="Build">
    <RemoveDir Directories="$(MSBuildThisFileDirectory)dist" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)dist\$(AssemblyName)" />
  </Target>

  <!-- Thunderstore package: dotnet build -c Release -t:Package
       Produces dist/abzuest-SceneSwitcher-<Version>.zip with the DLL, manifest, icon, README and CHANGELOG. -->
  <PropertyGroup>
    <ThunderstoreDir>$(MSBuildThisFileDirectory)thunderstore</ThunderstoreDir>
    <PackageStagingDir>$(BaseIntermediateOutputPath)thunderstore</PackageStagingDir>
    <PackageZip>$(MSBuildThisFileDirectory)dist\abzuest-$(AssemblyName)-$(Version).zip</PackageZip>
  </PropertyGroup>

  <Target Name="Package" DependsOnTargets="Build">
    <Error Condition="'$(Configuration)' != 'Release'" Text="Build the package in Release: dotnet build -c Release -t:Package" />
    <Error Condition="!Exists('$(ThunderstoreDir)\icon.png')" Text="Missing thunderstore/icon.png (256x256 PNG required by Thunderstore)." />

    <!-- Keep the three version numbers in sync: csproj, Plugin.cs and manifest.json. -->
    <ReadLinesFromFile File="$(ThunderstoreDir)\manifest.json">
      <Output TaskParameter="Lines" ItemName="ManifestLines" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)src\Plugin.cs">
      <Output TaskParameter="Lines" ItemName="PluginLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <ManifestText>@(ManifestLines)</ManifestText>
      <PluginText>@(PluginLines)</PluginText>
    </PropertyGroup>
    <Error Condition="!$(ManifestText.Contains('&quot;version_number&quot;: &quot;$(Version)&quot;'))" Text="thunderstore/manifest.json version_number does not match $(Version)." />
    <Error Condition="!$(PluginText.Contains('PluginVersion = &quot;$(Version)&quot;'))" Text="Plugin.PluginVersion does not match $(Version)." />

    <RemoveDir Directories="$(PackageStagingDir)" />
    <Copy SourceFiles="$(TargetPath);$(ThunderstoreDir)\manifest.json;$(ThunderstoreDir)\icon.png;$(ThunderstoreDir)\README.md;$(ThunderstoreDir)\CHANGELOG.md" DestinationFolder="$(PackageStagingDir)" />
    <ZipDirectory SourceDirectory="$(PackageStagingDir)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Thunderstore package: $(PackageZip)" />
  </Target>

</Project>
